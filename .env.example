# Public HTTPS origin; required for production indexing. Leave empty locally.
SITE_URL=
# All optional. Without Upstash, an in-memory cache is used (per server instance).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Provider switch: "espn" (default) or "api-football" (stub, needs implementing + key)
DATA_PROVIDER=espn
API_FOOTBALL_KEY=
API_FOOTBALL_SEASON=2026
# Crosscheck season label on TheSportsDB
TSDB_SEASON=2026-2027
